<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TOEIC Master</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
    <!-- ===================== HEADER ===================== -->
    <header class="site-header sticky-top">
        <div class="container-fluid px-lg-5">
            <nav class="navbar navbar-expand-lg py-0">
                <!-- 1. Logo (Left) -->
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-area="Student"
                    asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="brand-title">TOEIC<span class="brand-highlight">GREEN</span></span>
                        <span class="brand-sub">Mastery Learning</span>
                    </div>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarMain">
                    <i class="bi bi-list fs-2 text-success"></i>
                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse justify-content-between" id="navbarMain">
                    <!-- 2. Smooth Floating Background Slider Navbar (Center) -->
                    <div class="navbar-slidebar-wrapper mx-auto my-2 my-lg-0" id="slidebarContainer">
                        <!-- Floating Background Pill Indicator -->
                        <div class="nav-slider-indicator" id="navIndicator"></div>

                        <ul class="nav custom-slide-nav" id="mainSlideNav">
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                                   asp-area="Student" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door-fill me-1"></i>Trang chủ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Exams" ? "active" : "")" 
                                   asp-area="Student" asp-controller="Home" asp-action="Exams">
                                    <i class="bi bi-journal-text me-1"></i>Đề thi
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Vocab" ? "active" : "")" 
                                   asp-area="Student" asp-controller="Home" asp-action="Vocab">
                                    <i class="bi bi-translate me-1"></i>Từ vựng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Grammar" ? "active" : "")" 
                                   asp-area="Student" asp-controller="Home" asp-action="Grammar">
                                    <i class="bi bi-journal-code me-1"></i>Ngữ pháp
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- 3. Auth Buttons (Right) -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <button class="btn btn-auth-login" data-bs-toggle="modal" data-bs-target="#authModal"
                            onclick="setAuthMode('login')">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                        </button>
                        <button class="btn btn-auth-register shadow-sm" data-bs-toggle="modal"
                            data-bs-target="#authModal" onclick="setAuthMode('register')">
                            <i class="bi bi-person-plus-fill me-1"></i>Đăng ký
                        </button>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- ===================== BODY CONTENT ===================== -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- ===================== FOOTER ===================== -->
    <footer class="site-footer bg-white border-top pt-5 pb-4 mt-auto">
        <div class="container-fluid px-lg-5">
            <div class="row g-4 mb-4">
                <!-- Col 1: Brand & Giới thiệu -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon-box">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div>
                            <span class="fw-bold text-success fs-5">TOEIC<span class="text-dark">GREEN</span></span>
                            <span class="d-block text-muted x-small fw-semibold text-uppercase tracking-wider">Luyện Thi
                                Thông Minh</span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-3 lh-base">
                        Nền tảng học và luyện thi TOEIC trực tuyến hàng đầu, cung cấp kho đề thi chuẩn cấu trúc ETS,
                        phương pháp học từ vựng thông minh và phân tích chi tiết lộ trình học tập.
                    </p>
                </div>
            </div>

            <!-- Bottom Line: Copyright & Policies -->
            <div
                class="border-top pt-3 mt-2 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <p class="text-muted x-small mb-0">
                    &copy; @DateTime.Now.Year <strong class="text-success">TOEIC Green</strong>. Mọi quyền được bảo lưu.
                    Thiết kế dành cho học viên ôn thi TOEIC.
                </p>
                <div class="d-flex gap-3 x-small">
                    <a asp-area="Student" asp-controller="Home" asp-action="Privacy"
                        class="text-muted text-decoration-none hover-success">Điều khoản sử dụng</a>
                    <span class="text-muted">•</span>
                    <a asp-area="Student" asp-controller="Home" asp-action="Privacy"
                        class="text-muted text-decoration-none hover-success">Chính sách bảo mật</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ===================== AUTH MODAL ===================== -->
    <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
                <div class="modal-header border-0 pb-0 justify-content-end">
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <div class="text-center mb-3">
                        <div class="brand-icon-box mx-auto mb-2" style="width: 50px; height: 50px; font-size: 1.5rem;">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <h4 class="fw-bold text-dark" id="modalTitle">Đăng nhập tài khoản</h4>
                        <p class="text-muted small mb-0" id="modalSubtitle">Truy cập hàng trăm bộ đề và từ vựng TOEIC
                            miễn phí</p>
                    </div>

                    <!-- Nút đăng nhập bằng Google và Facebook nằm ngang nhau -->
                    <div class="row g-2 mb-3 mt-3">
                        <div class="col-6">
                            <button type="button"
                                class="btn btn-social-google w-100 py-2 d-flex align-items-center justify-content-center gap-2 border shadow-xs"
                                onclick="alert('Đang kết nối tài khoản Google...')">
                                <svg width="18" height="18" viewBox="0 0 24 24">
                                    <path fill="#4285F4"
                                        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                                    <path fill="#34A853"
                                        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                                    <path fill="#FBBC05"
                                        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                                    <path fill="#EA4335"
                                        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                                </svg>
                                <span class="fw-semibold small text-dark">Google</span>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button"
                                class="btn btn-social-facebook w-100 py-2 d-flex align-items-center justify-content-center gap-2 border-0 text-white shadow-xs"
                                onclick="alert('Đang kết nối tài khoản Facebook...')">
                                <i class="bi bi-facebook fs-5"></i>
                                <span class="fw-semibold small">Facebook</span>
                            </button>
                        </div>
                    </div>

                    <!-- Đường phân cách hoặc -->
                    <div class="position-relative text-center my-3">
                        <hr class="text-muted opacity-25">
                        <span
                            class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted">hoặc
                            bằng email</span>
                    </div>

                    <form id="authForm"
                        onsubmit="event.preventDefault(); alert('Đã gửi thông tin thành công!'); bootstrap.Modal.getInstance(document.getElementById('authModal')).hide();">
                        <div class="mb-3" id="registerNameGroup" style="display: none;">
                            <label class="form-label small fw-semibold text-muted">Họ và tên</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-success"><i
                                        class="bi bi-person"></i></span>
                                <input type="text" class="form-control bg-light border-start-0"
                                    placeholder="Nguyễn Văn A">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Email / Tên đăng nhập</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-success"><i
                                        class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control bg-light border-start-0"
                                    placeholder="student@toeicgreen.vn" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-success"><i
                                        class="bi bi-lock"></i></span>
                                <input type="password" class="form-control bg-light border-start-0"
                                    placeholder="••••••••" required>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 small" id="loginOptions">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="rememberMe" checked>
                                <label class="form-check-label text-muted" for="rememberMe">Ghi nhớ</label>
                            </div>
                            <a href="#" class="text-success text-decoration-none fw-semibold">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" class="btn btn-auth-register w-100 py-2 fw-bold shadow-sm"
                            id="authSubmitBtn">
                            Đăng nhập
                        </button>

                        <div class="text-center mt-3 small">
                            <span class="text-muted" id="authSwitchText">Chưa có tài khoản?</span>
                            <a href="javascript:void(0)" class="text-success fw-bold text-decoration-none ms-1"
                                id="authSwitchLink" onclick="toggleAuthMode()">Đăng ký ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>