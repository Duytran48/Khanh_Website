@model Khanh_Project.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Ôn Luyện TOEIC Đạt Điểm Cao";
    
    // Đề thi counts
    var examCompletedCount = Model.AvailableExams.Count(e => e.Status == "completed");
    var examInProgressCount = Model.AvailableExams.Count(e => e.Status == "in-progress");

    // Từ vựng chủ đề counts
    var vocabCompletedCount = Model.VocabTopics.Count(v => v.Status == "completed");
    var vocabInProgressCount = Model.VocabTopics.Count(v => v.Status == "in-progress");
}

<div class="page-container py-4">
    <div class="container-fluid px-lg-5">

        <!-- ==================== 1. USER GREETING & HERO BANNER ==================== -->
        <section id="home" class="mb-4 section-anchor">
            <div class="hero-card p-4 p-md-5 rounded-4 shadow-sm position-relative overflow-hidden">
                <div class="row align-items-center gy-4">
                    <div class="col-lg-8">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-75 text-success fw-bold small mb-3 border border-success border-opacity-20">
                            <i class="bi bi-calendar2-week text-success me-1"></i> Hôm nay, @DateTime.Now.ToString("dd/MM/yyyy") - Chúc bạn ngày mới vui vẻ! 
                        </div>
                        <h1 class="display-6 fw-extrabold text-dark mb-3">
                            Xin chào, <span class="text-success text-gradient">@Model.UserName!</span>
                        </h1>
                        <p class="lead text-secondary mb-4 fs-6" style="max-width: 600px;">
                            Hãy duy trì chuỗi học tập hôm nay để sớm đạt mục tiêu <strong class="text-success">@Model.TargetScore+ TOEIC</strong>. Bạn có thể xem tổng quan tiến độ hoặc bắt đầu luyện đề bên dưới.
                        </p>
                        
                        <!-- Learning Stats Preview -->
                        <div class="d-flex flex-wrap gap-3 align-items-center">
                            <div class="stat-badge d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-3 shadow-xs border">
                                <div class="stat-icon bg-warning-subtle text-warning rounded-circle">
                                    <i class="bi bi-fire"></i>
                                </div>
                                <div>
                                    <span class="d-block text-muted x-small">Chuỗi học tập</span>
                                    <strong class="text-dark">@Model.CurrentStreak Ngày liên tiếp</strong>
                                </div>
                            </div>

                            <div class="stat-badge d-flex align-items-center gap-2 bg-white px-3 py-2 rounded-3 shadow-xs border">
                                <div class="stat-icon bg-success-subtle text-success rounded-circle">
                                    <i class="bi bi-bullseye"></i>
                                </div>
                                <div>
                                    <span class="d-block text-muted x-small">Mục tiêu</span>
                                    <strong class="text-dark">Target @Model.TargetScore+</strong>
                                </div>
                            </div>
                            </a>
                        </div>
                    </div>

                    <!-- Hero Visual -->
                    <div class="col-lg-4 text-center">
                        <div class="hero-illustration-box bg-white p-4 rounded-4 shadow-sm border border-emerald-subtle">
                            <div class="circle-progress-wrapper mx-auto mb-3">
                                <div class="circle-avatar">
                                    <i class="bi bi-trophy-fill text-warning fs-1"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold text-dark mb-1">Mục tiêu hôm nay</h5>
                            <p class="text-muted small mb-3">Hoàn thành bài luyện tập để tích lũy thêm điểm chuẩn bị cho kỳ thi.</p>
                            <a href="#exams" class="btn btn-outline-success w-100 rounded-pill fw-bold btn-sm py-2">
                                <i class="bi bi-arrow-down-circle me-1"></i>Đến danh sách đề &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== 2. TỔNG QUAN TIẾN ĐỘ HỌC TẬP (MỚI THAY THẾ NGỮ PHÁP) ==================== -->
        <section id="overview" class="mb-5 section-anchor">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>   
                    <h2 class="fw-bold text-dark mb-0">Tổng Quan Tiến Độ</h2>   
                </div>
            </div>

            <div class="row g-4">
                <!-- Card 1: Đề vừa được làm (Hiển thị điểm thi hình tròn) -->
                <div class="col-lg-5">
                    <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white overview-card border-top border-4 border-primary d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill small">
                                    <i class="bi bi-journal-check me-1"></i>Đề thi vừa hoàn thành
                                </span>
                                <span class="text-muted x-small"><i class="bi bi-clock me-1"></i>@Model.Overview.RecentExamDate</span>
                            </div>

                            <h5 class="fw-bold text-dark mb-3">@Model.Overview.RecentExamTitle</h5>

                            <div class="row align-items-center">
                                <!-- Vòng tròn hiển thị điểm số giống hình ảnh mẫu -->
                                <div class="col-sm-5 text-center mb-3 mb-sm-0">
                                    <div class="circle-score-container mx-auto">
                                        <svg viewBox="0 0 100 100" width="125" height="125">
                                            <!-- Vòng tròn nền nhạt -->
                                            <circle cx="50" cy="50" r="42" fill="none" stroke="#e2e8f0" stroke-width="9" />
                                            <!-- Vòng tròn tiến độ điểm xanh dương -->
                                            <circle cx="50" cy="50" r="42" fill="none" stroke="#2563eb" stroke-width="9"
                                                    stroke-linecap="round"
                                                    stroke-dasharray="264"
                                                    stroke-dashoffset="45"
                                                    transform="rotate(-90 50 50)" />
                                        </svg>
                                        <div class="circle-score-content">
                                            <div class="score-number">@Model.Overview.RecentExamScore</div>
                                            <span class="score-label">/ @Model.Overview.RecentExamTotal điểm</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-7 ps-sm-2">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted fs-6">Mục tiêu:</span>
                                            <span class="text-dark fw-bold fs-6">@Model.Overview.TargetScore đ</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted fs-6">Khoảng cách:</span>
                                            <span class="text-primary fw-bold fs-6">+@Model.Overview.MissingScore đ cần đạt</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-outline-primary py-2 w-100 fw-bold rounded-pill" onclick="alert('Xem bảng phân tích chi tiết kết quả bài: @Model.Overview.RecentExamTitle')">
                                <i class="bi bi-bar-chart-fill me-1"></i>Xem lại đáp án và lời giải
                            </button>
                        </div>
                    </div>  
                </div>

                <!-- Card 2: Chủ đề từ vựng mới vừa học xong -->
                <div class="col-lg-3 col-md-6">
                    <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white overview-card border-top border-4 border-success d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill small">
                                    <i class="bi bi-translate me-1"></i>Từ vựng vừa xong
                                </span>
                                <span class="text-muted x-small">@Model.Overview.RecentVocabTime</span>
                            </div>

                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="overview-icon-badge bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-people-fill fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@Model.Overview.RecentVocabTopic</h6>
                                    <span class="text-muted small">Chủ đề 600 từ TOEIC</span>
                                </div>
                            </div>

                            <div class="p-3 bg-light-green rounded-3 border border-success border-opacity-20">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted fs-6">Đã ghi nhớ:</span>
                                    <strong class="text-success fs-6 fw-bold">@Model.Overview.RecentVocabCount / @Model.Overview.RecentVocabCount từ</strong>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success rounded-pill" style="width: 100%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-outline-success py-2 w-100 fw-bold rounded-pill" onclick="alert('Đang mở danh sách chủ đề từ vựng mới!')">
                                <i class="bi bi-plus-circle me-1"></i>Học chủ đề mới
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Bài ngữ pháp mới vừa học -->
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white overview-card border-top border-4 border-warning d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-3 py-1 rounded-pill small">
                                <i class="bi bi-bookmark-check-fill me-1"></i>Ngữ pháp vừa học
                            </span>
                            <span class="text-muted x-small">@Model.Overview.RecentGrammarTime</span>
                        </div>

                        <div class="d-flex flex-column align-items-center justify-content-center text-center my-auto py-2">
                            <div class="overview-icon-badge bg-warning bg-opacity-10 text-warning-emphasis mb-3" style="width: 60px; height: 60px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%;">
                                <i class="bi bi-journal-code fs-2"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-0">@Model.Overview.RecentGrammarTitle</h5>
                        </div>

                        <div class="mt-3">
                            <button class="btn btn-outline-warning text-dark py-2 w-100 fw-bold rounded-pill" onclick="alert('Đang mở bài học: @Model.Overview.RecentGrammarTitle')">
                                <i class="bi bi-pencil-square me-1"></i>Làm bài tập củng cố
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== 3. AVAILABLE EXAMS SECTION (NẰM DƯỚI PHẦN TỔNG QUAN) ==================== -->
        <section id="exams" class="mb-5 section-anchor">
            <div class="d-flex flex-column mb-4 gap-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <h2 class="fw-bold text-dark mb-0">Thư Viện Đề Thi</h2>

                    <!-- 1. Bộ lọc trạng thái đề thi (Tất cả, Đã hoàn thành, Đang làm dở - Đã bỏ Chưa làm) -->
                    <div class="exam-filter-pills d-flex flex-wrap gap-2">
                        <button class="filter-btn active" data-filter="all" onclick="filterExams('all')">
                            <i class="bi bi-grid-fill me-1"></i>Tất cả (@Model.AvailableExams.Count)
                        </button>
                        <button class="filter-btn" data-filter="completed" onclick="filterExams('completed')">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>Đã hoàn thành (@examCompletedCount)
                        </button>
                        <button class="filter-btn" data-filter="in-progress" onclick="filterExams('in-progress')">
                            <i class="bi bi-hourglass-split text-warning me-1"></i>Đang làm dở (@examInProgressCount)
                        </button>
                    </div>
                </div>

                <!-- 2. Bộ lọc theo loại đề TOEIC (ETS, HACKER, BIGSTEP, ECONOMY...) -->
                <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top">
                    <span class="text-muted small fw-semibold me-1"><i class="bi bi-funnel-fill text-success me-1"></i>Bộ đề:</span>
                    <div class="exam-series-pills d-flex flex-wrap gap-2">
                        <button class="filter-btn active py-1 px-3 small" data-series-filter="all" onclick="filterExamSeries('all')">
                            Tất cả bộ đề
                        </button>
                        <button class="filter-btn py-1 px-3 small" data-series-filter="ETS" onclick="filterExamSeries('ETS')">
                            ETS
                        </button>
                        <button class="filter-btn py-1 px-3 small" data-series-filter="HACKER" onclick="filterExamSeries('HACKER')">
                            HACKER
                        </button>
                        <button class="filter-btn py-1 px-3 small" data-series-filter="BIGSTEP" onclick="filterExamSeries('BIGSTEP')">
                            BIG STEP
                        </button>
                        <button class="filter-btn py-1 px-3 small" data-series-filter="ECONOMY" onclick="filterExamSeries('ECONOMY')">
                            ECONOMY
                        </button>
                    </div>
                </div>
            </div>

            <!-- Exam Cards Grid -->
            <div class="row g-4" id="examCardsGrid">
                @foreach (var exam in Model.AvailableExams)
                {
                    <div class="col-md-6 col-lg-4 exam-card-item" data-status="@exam.Status" data-series="@exam.Series">
                        <div class="card h-100 border-0 rounded-4 shadow-sm exam-card overflow-hidden position-relative">
                            
                            <div class="card-body p-4 d-flex flex-column">
                                <!-- Card Header Badges: Category & Status -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex gap-1 align-items-center">
                                        <span class="badge bg-emerald-light text-emerald px-3 py-1 rounded-pill fw-semibold">
                                            @exam.Category
                                        </span>
                                        <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill small fw-semibold">
                                            @exam.Series
                                        </span>
                                    </div>
                                    
                                    @if (exam.Status == "completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2 py-1 rounded-pill small fw-semibold">
                                            <i class="bi bi-check2-circle me-1"></i>Đã xong @(exam.Score.HasValue ? $"({exam.Score}đ)" : "")
                                        </span>
                                    }
                                    else if (exam.Status == "in-progress")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning border-opacity-25 px-2 py-1 rounded-pill small fw-semibold">
                                            <i class="bi bi-clock-history me-1"></i>Đang làm (@exam.CompletedQuestions/@exam.TotalQuestions câu)
                                        </span>
                                    }
                                </div>

                                <!-- Exam Title -->
                                <h5 class="card-title fw-bold text-dark mb-2">@exam.Title</h5>
                                <p class="card-text text-muted small mb-3 flex-grow-1">@exam.Description</p>

                                <!-- Progress bar for in-progress tests -->
                                @if (exam.Status == "in-progress")
                                {
                                    var progressPercent = (int)((double)exam.CompletedQuestions / exam.TotalQuestions * 100);
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between text-muted x-small mb-1">
                                            <span>Tiến độ làm bài:</span>
                                            <strong class="text-warning-emphasis">@progressPercent%</strong>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-warning" role="progressbar" style="width: @progressPercent%"></div>
                                        </div>
                                    </div>
                                }
                                else if (exam.Status == "completed")
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between text-muted x-small mb-1">
                                            <span>Kết quả:</span>
                                            <strong class="text-success">Đã hoàn thành 100%</strong>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 100%"></div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between text-muted x-small mb-1">
                                            <span>Tiến độ làm bài:</span>
                                            <strong class="text-secondary">0%</strong>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-secondary opacity-50" role="progressbar" style="width: 0%"></div>
                                        </div>
                                    </div>
                                }

                                <!-- Meta Info Grid -->
                                <div class="exam-meta-grid p-3 rounded-3 bg-light-green mb-4">
                                    <div class="meta-item">
                                        <i class="bi bi-clock-history text-success"></i>
                                        <span>@exam.DurationMinutes phút</span>
                                    </div>
                                    <div class="meta-item">
                                        <i class="bi bi-question-circle text-success"></i>
                                        <span>@exam.TotalQuestions câu</span>
                                    </div>
                                    <div class="meta-item">
                                        <i class="bi bi-people text-success"></i>
                                        <span>@exam.ParticipantsCount.ToString("N0") lượt</span>
                                    </div>
                                </div>

                                <!-- Card Actions based on Status -->
                                <div class="d-flex gap-2">
                                    @if (exam.Status == "completed")
                                    {
                                        <button class="btn btn-outline-success w-100 fw-bold py-2 rounded-3" onclick="startExam(@exam.Id, '@exam.Title')">
                                            <i class="bi bi-arrow-repeat me-1"></i> Làm lại
                                        </button>
                                        <button class="btn btn-success px-3 py-2 rounded-3" title="Xem kết quả" onclick="alert('Kết quả bài thi: @exam.Title\nĐiểm số đạt được: @exam.Score / 990')">
                                            <i class="bi bi-clipboard-check"></i>
                                        </button>
                                    }
                                    else if (exam.Status == "in-progress")
                                    {
                                        <button class="btn btn-warning w-100 fw-bold py-2 rounded-3 text-dark" onclick="startExam(@exam.Id, '@exam.Title')">
                                            <i class="bi bi-play-fill me-1"></i> Làm tiếp (@exam.CompletedQuestions/@exam.TotalQuestions)
                                        </button>
                                        <button class="btn btn-outline-secondary px-3 py-2 rounded-3" title="Chi tiết đề" onclick="alert('Đề thi: @exam.Title\nThời lượng: @exam.DurationMinutes phút\nĐã làm: @exam.CompletedQuestions/@exam.TotalQuestions câu')">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-emerald w-100 fw-bold py-2 rounded-3" onclick="startExam(@exam.Id, '@exam.Title')">
                                            <i class="bi bi-pencil-square me-1"></i> Làm bài
                                        </button>
                                        <button class="btn btn-outline-secondary px-3 py-2 rounded-3" title="Chi tiết đề" onclick="alert('Đề thi: @exam.Title\nThời lượng: @exam.DurationMinutes phút\nSố câu: @exam.TotalQuestions')">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- ==================== 4. VOCABULARY TOPICS SECTION ==================== -->
        <section id="vocab" class="mb-5 section-anchor">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <div>
                    <h2 class="fw-bold text-dark mb-0">Chủ Đề Từ Vựng Đã Học</h2>
                </div>

                <!-- Vocabulary Topic Filter Pills -->
                <div class="vocab-filter-pills d-flex flex-wrap gap-2">
                    <button class="filter-btn active" data-vocab-filter="all" onclick="filterVocabTopics('all')">
                        <i class="bi bi-grid-fill me-1"></i>Tất cả (@Model.VocabTopics.Count)
                    </button>
                    <button class="filter-btn" data-vocab-filter="completed" onclick="filterVocabTopics('completed')">
                        <i class="bi bi-check-circle-fill text-success me-1"></i>Đã học (@vocabCompletedCount)
                    </button>
                    <button class="filter-btn" data-vocab-filter="in-progress" onclick="filterVocabTopics('in-progress')">
                        <i class="bi bi-hourglass-split text-warning me-1"></i>Đang học (@vocabInProgressCount)
                    </button>
                </div>
            </div>

            <div class="row g-4" id="vocabTopicsGrid">
                @foreach (var topic in Model.VocabTopics)
                {
                    var progressPercent = (int)((double)topic.LearnedWords / topic.TotalWords * 100);
                    <div class="col-md-6 col-lg-4 vocab-topic-item" data-status="@topic.Status">
                        <div class="card h-100 border-0 rounded-4 shadow-sm vocab-topic-card p-4 d-flex flex-column justify-content-between bg-white position-relative">
                            <div>
                                <!-- Header: Icon, Target Band & Status Badge -->
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="topic-icon-box rounded-3 p-3 text-white @(topic.Status == "completed" ? "bg-success" : topic.Status == "in-progress" ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-secondary border")">
                                        <i class="bi @topic.Icon fs-4 @(topic.Status == "in-progress" ? "text-warning-emphasis" : "")"></i>
                                    </div>
                                    <div class="text-end">
                                        @if (topic.Status == "completed")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2 py-1 rounded-pill small fw-semibold">
                                                <i class="bi bi-check-all me-1"></i>Đã học xong
                                            </span>
                                        }
                                        else if (topic.Status == "in-progress")
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning border-opacity-25 px-2 py-1 rounded-pill small fw-semibold">
                                                <i class="bi bi-clock-history me-1"></i>Đang học
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1 rounded-pill small">
                                                <i class="bi bi-circle me-1"></i>Chưa học
                                            </span>
                                        }
                                        <span class="d-block text-muted x-small mt-1">Mục tiêu @topic.TargetBand</span>
                                    </div>
                                </div>

                                <!-- Title & Description -->
                                <h5 class="fw-bold text-dark mb-2">@topic.Title</h5>
                                <p class="text-muted small mb-4">@topic.Description</p>
                            </div>

                            <!-- Progress & Action -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center small mb-1">
                                    <span class="text-muted">Tiến độ từ vựng:</span>
                                    <strong class="@(topic.Status == "completed" ? "text-success" : topic.Status == "in-progress" ? "text-warning-emphasis" : "text-muted")">
                                        @topic.LearnedWords / @topic.TotalWords từ (@progressPercent%)
                                    </strong>
                                </div>
                                <div class="progress mb-4" style="height: 8px;">
                                    <div class="progress-bar @(topic.Status == "completed" ? "bg-success" : topic.Status == "in-progress" ? "bg-warning" : "bg-secondary")" 
                                         role="progressbar" 
                                         style="width: @progressPercent%"></div>
                                </div>

                                <!-- Button by Status -->
                                @if (topic.Status == "completed")
                                {
                                    <a class="btn btn-outline-success w-100 fw-bold py-2 rounded-3 text-decoration-none" asp-area="Student" asp-controller="Home" asp-action="VocabDetail" asp-route-id="@topic.Id">
                                        <i class="bi bi-arrow-repeat me-1"></i> Ôn tập lại (@topic.TotalWords từ)
                                    </a>
                                } 
                                else if (topic.Status == "in-progress")
                                {
                                    <a class="btn btn-warning w-100 fw-bold py-2 rounded-3 text-dark text-decoration-none" asp-area="Student" asp-controller="Home" asp-action="VocabDetail" asp-route-id="@topic.Id">
                                        <i class="bi bi-play-fill me-1"></i> Học tiếp (@topic.LearnedWords/@topic.TotalWords từ)
                                    </a>
                                }
                                else
                                {
                                    <a class="btn btn-emerald w-100 fw-bold py-2 rounded-3 text-decoration-none" asp-area="Student" asp-controller="Home" asp-action="VocabDetail" asp-route-id="@topic.Id">
                                        <i class="bi bi-book me-1"></i> Bắt đầu học
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

    </div>
</div>