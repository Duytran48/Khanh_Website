@model Khanh_Project.Models.HomeViewModel
@{
    ViewData["Title"] = "Ngữ Pháp TOEIC Trọng Điểm";
}

<div class="page-container py-4">
    <div class="container-fluid px-lg-5">
        <!-- Breadcrumb & Header -->
        <div class="mb-4">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a asp-area="Student" asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Ngữ pháp TOEIC</li>
                </ol>
            </nav>
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h2 class="fw-bold text-dark mb-1">Ngữ Pháp TOEIC Trọng Điểm</h2>
                    <p class="text-muted small mb-0">Hệ thống hóa toàn bộ kiến thức ngữ pháp cốt lõi xuất hiện 95% trong Part 5 & 6.</p>
                </div>
            </div>
        </div>

        <!-- Grammar Topics Grid -->
        <div class="row g-4">
            <!-- Topic 1 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between border-top border-4 border-success">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill small">
                                <i class="bi bi-check-circle-fill me-1"></i>Đã học
                            </span>
                            <span class="badge bg-light text-muted border small">Cơ bản • 450+</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="overview-icon-badge bg-success bg-opacity-10 text-success">
                                <i class="bi bi-clock-history fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">12 Thì Trong Tiếng Anh</h5>
                                <span class="text-muted small">Hiện tại, Quá khứ, Tương lai & Hoàn thành</span>
                            </div>
                        </div>
                        <p class="text-secondary small mb-4">
                            Nắm vững quy tắc chia động từ, dấu hiệu nhận biết thì (signal words) và cách tránh bẫy thì hay gặp trong đề thi TOEIC.
                        </p>
                    </div>
                    <button class="btn btn-outline-success w-100 fw-bold py-2 rounded-3" onclick="alert('Đang mở ôn tập: 12 Thì Trong Tiếng Anh')">
                        <i class="bi bi-arrow-repeat me-1"></i>Ôn tập & Luyện bài tập
                    </button>
                </div>
            </div>

            <!-- Topic 2 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between border-top border-4 border-warning">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-3 py-1 rounded-pill small">
                                <i class="bi bi-hourglass-split me-1"></i>Đang học
                            </span>
                            <span class="badge bg-light text-muted border small">Trung cấp • 650+</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="overview-icon-badge bg-warning bg-opacity-10 text-warning-emphasis">
                                <i class="bi bi-journal-code fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Mệnh Đề Quan Hệ & Rút Gọn</h5>
                                <span class="text-muted small">Who, Whom, Which, That & V-ing / V-ed</span>
                            </div>
                        </div>
                        <p class="text-secondary small mb-4">
                            Quy tắc rút gọn mệnh đề quan hệ chủ động (V-ing), bị động (V-ed/V3) và cụm to-V thường xuyên xuất hiện ở các câu 700+ Part 5.
                        </p>
                    </div>
                    <button class="btn btn-warning w-100 fw-bold py-2 rounded-3 text-dark" onclick="alert('Tiếp tục học: Mệnh Đề Quan Hệ')">
                        <i class="bi bi-play-fill me-1"></i>Học tiếp bài học
                    </button>
                </div>
            </div>

            <!-- Topic 3 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between border-top border-4 border-primary">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill small">
                                <i class="bi bi-book me-1"></i>Chưa học
                            </span>
                            <span class="badge bg-light text-muted border small">Nâng cao • 750+</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="overview-icon-badge bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-shuffle fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Đảo Ngữ & Câu Điều Kiện</h5>
                                <span class="text-muted small">Inversion & Conditionals Type 1, 2, 3</span>
                            </div>
                        </div>
                        <p class="text-secondary small mb-4">
                            Bí quyết nhận diện cấu trúc đảo ngữ với Should, Were, Had, Only after, Seldom, Hardly và câu điều kiện hỗn hợp.
                        </p>
                    </div>
                    <button class="btn btn-emerald w-100 fw-bold py-2 rounded-3" onclick="alert('Bắt đầu học: Đảo Ngữ & Câu Điều Kiện')">
                        <i class="bi bi-book me-1"></i>Bắt đầu học ngay
                    </button>
                </div>
            </div>

            <!-- Topic 4 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between border-top border-4 border-secondary">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill small">
                                <i class="bi bi-book me-1"></i>Chưa học
                            </span>
                            <span class="badge bg-light text-muted border small">Cơ bản • 500+</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="overview-icon-badge bg-secondary bg-opacity-10 text-secondary">
                                <i class="bi bi-arrow-left-right fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Câu Bị Động (Passive Voice)</h5>
                                <span class="text-muted small">Dạng thức bị động mọi thì & Động từ khuyết thiếu</span>
                            </div>
                        </div>
                        <p class="text-secondary small mb-4">
                            Cách phân biệt nhanh thể chủ động và bị động dựa vào tân ngữ phía sau động từ chính trong câu Part 5.
                        </p>
                    </div>
                    <button class="btn btn-emerald w-100 fw-bold py-2 rounded-3" onclick="alert('Bắt đầu học: Câu Bị Động')">
                        <i class="bi bi-book me-1"></i>Bắt đầu học ngay
                    </button>
                </div>
            </div>

            <!-- Topic 5 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between border-top border-4 border-secondary">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill small">
                                <i class="bi bi-book me-1"></i>Chưa học
                            </span>
                            <span class="badge bg-light text-muted border small">Trung cấp • 600+</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="overview-icon-badge bg-secondary bg-opacity-10 text-secondary">
                                <i class="bi bi-link-45deg fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Liên Từ & Giới Từ (Conjunctions)</h5>
                                <span class="text-muted small">Although/Despite, Because/Because of</span>
                            </div>
                        </div>
                        <p class="text-secondary small mb-4">
                            Quy tắc vàng phân biệt liên từ đi kèm mệnh đề (S + V) và giới từ đi kèm cụm danh từ (Noun Phrase / V-ing).
                        </p>
                    </div>
                    <button class="btn btn-emerald w-100 fw-bold py-2 rounded-3" onclick="alert('Bắt đầu học: Liên Từ & Giới Từ')">
                        <i class="bi bi-book me-1"></i>Bắt đầu học ngay
                    </button>
                </div>
            </div>

            <!-- Topic 6 -->
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 rounded-4 shadow-sm p-4 bg-white d-flex flex-column justify-content-between border-top border-4 border-secondary">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill small">
                                <i class="bi bi-book me-1"></i>Chưa học
                            </span>
                            <span class="badge bg-light text-muted border small">Trung cấp • 650+</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="overview-icon-badge bg-secondary bg-opacity-10 text-secondary">
                                <i class="bi bi-diagram-3-fill fs-4"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Danh Động Từ & Động Từ Nguyên Mẫu</h5>
                                <span class="text-muted small">Gerund (V-ing) vs Infinitive (To V)</span>
                            </div>
                        </div>
                        <p class="text-secondary small mb-4">
                            Tổng hợp danh sách các động từ chỉ đi kèm V-ing (enjoy, avoid, consider...) hoặc chỉ đi kèm to-V (decide, hope, plan...).
                        </p>
                    </div>
                    <button class="btn btn-emerald w-100 fw-bold py-2 rounded-3" onclick="alert('Bắt đầu học: Danh Động Từ')">
                        <i class="bi bi-book me-1"></i>Bắt đầu học ngay
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
