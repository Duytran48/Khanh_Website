@model List<Khanh_Project.Models.ToeicExam>
@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị";
}

<div class="row g-4 mb-4">
    <!-- Stat Cards -->
    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Tổng học viên</span>
                    <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalStudents</h3>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3 fs-4">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Tổng đề thi</span>
                    <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalExams</h3>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-4">
                    <i class="bi bi-journal-code"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Lượt thi hôm nay</span>
                    <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalSubmissionsToday</h3>
                </div>
                <div class="p-3 bg-warning-subtle text-warning-emphasis rounded-3 fs-4">
                    <i class="bi bi-lightning-charge-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 rounded-4 shadow-sm p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold">Điểm TB học viên</span>
                    <h3 class="fw-bold text-dark mb-0">@ViewBag.AverageScore/990</h3>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-3 fs-4">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Exam Management Table -->
<div class="card border-0 rounded-4 shadow-sm bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold text-dark mb-1">Danh Sách Đề Thi Trọng Điểm</h5>
            <p class="text-muted small mb-0">Quản lý, chỉnh sửa câu hỏi và thống kê lượt thi</p>
        </div>
        <button class="btn btn-emerald rounded-3 fw-bold btn-sm py-2 px-3" onclick="alert('Mở form thêm đề thi mới')">
            <i class="bi bi-plus-lg me-1"></i> Thêm đề thi mới
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Mã đề</th>
                    <th>Tên đề thi</th>
                    <th>Loại đề</th>
                    <th>Số câu hỏi</th>
                    <th>Lượt thi</th>
                    <th>Đánh giá</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.Id</strong></td>
                        <td><span class="fw-semibold text-dark">@item.Title</span></td>
                        <td><span class="badge bg-light text-success border">@item.Category</span></td>
                        <td>@item.TotalQuestions câu</td>
                        <td><span class="text-primary fw-bold">@item.ParticipantsCount.ToString("N0")</span></td>
                        <td><i class="bi bi-star-fill text-warning me-1"></i>@item.Rating</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="alert('Sửa đề: @item.Title')">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="alert('Xóa đề: @item.Title')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>