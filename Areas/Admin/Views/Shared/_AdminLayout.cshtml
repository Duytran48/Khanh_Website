<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị TOEIC Master</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Admin Header -->
    <header class="site-header sticky-top bg-white border-bottom shadow-xs">
        <div class="container-fluid px-4">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div class="d-flex align-items-center gap-3">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
                        <div class="brand-icon-box" style="background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <span class="fw-bold text-dark fs-5">TOEIC<span class="text-success">ADMIN</span></span>
                    </a>
                    <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-semibold">Quản trị viên</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a asp-area="Student" asp-controller="Home" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill fw-bold">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Xem trang Học viên
                    </a>
                    <div class="d-flex align-items-center gap-2 border-start ps-3">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                            AD
                        </div>
                        <span class="small fw-bold text-dark">Admin Khánh</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Admin Body Layout -->
    <div class="container-fluid px-4 py-4">
        @RenderBody()
    </div>

    <!-- Admin Footer -->
    <footer class="site-footer bg-white border-top mt-auto py-3">
        <div class="container-fluid px-4 text-center text-muted small">
            &copy; @DateTime.Now.Year TOEIC Master Admin Portal. Bảo mật & Quản lý hệ thống.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>